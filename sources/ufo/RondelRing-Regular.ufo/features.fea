lookup MONO_OPEN { sub less by monogram.ring; } MONO_OPEN;
lookup MONO_CLOSE { sub greater by monogram.end; } MONO_CLOSE;
lookup MONOGRAM {
  sub less' lookup MONO_OPEN @MONO_IN' lookup MONO_MONO3L @MONO_IN' lookup MONO_MONO3C @MONO_IN' lookup MONO_MONO3R greater' lookup MONO_CLOSE;
  sub less' lookup MONO_OPEN @MONO_IN' lookup MONO_MONO2L @MONO_IN' lookup MONO_MONO2R greater' lookup MONO_CLOSE;
  sub less' lookup MONO_OPEN @MONO_IN' lookup MONO_MONO1 greater' lookup MONO_CLOSE;
} MONOGRAM;
feature calt { lookup MONOGRAM; } calt;
feature liga { lookup MONOGRAM; } liga;
